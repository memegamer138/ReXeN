# Dockerfile for subfinder tool
FROM golang:1.24-alpine AS builder

RUN apk add --no-cache git

RUN git clone https://github.com/projectdiscovery/subfinder.git /src/subfinder
WORKDIR /src/subfinder/cmd/subfinder
RUN go build -o /usr/local/bin/subfinder

# Minimal runtime image
FROM alpine:3.18
COPY --from=builder /usr/local/bin/subfinder /usr/local/bin/subfinder
