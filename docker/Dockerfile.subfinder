# Dockerfile for subfinder tool
FROM golang:1.24-alpine AS builder

RUN apk add --no-cache git

RUN git clone https://github.com/projectdiscovery/subfinder.git /subfinder \
    && cd /subfinder \
    && git checkout v2.12.0 \
    && cd /subfinder/cmd/subfinder \
    && go build -o /usr/local/bin/subfinder

# Minimal runtime image
FROM alpine:3.18
COPY --from=builder /usr/local/bin/subfinder /usr/local/bin/subfinder
