# Dockerfile for katana tool
FROM golang:1.24-alpine AS builder

RUN apk add --no-cache git
RUN git clone https://github.com/projectdiscovery/katana.git /src/katana
WORKDIR /src/katana/cmd/katana
RUN go build -o /usr/local/bin/katana

# Minimal runtime image
FROM alpine:3.18
COPY --from=builder /usr/local/bin/katana /usr/local/bin/katana
