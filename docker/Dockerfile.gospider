# Dockerfile for gospider tool
FROM golang:1.24-alpine AS builder

RUN apk add --no-cache git
RUN git clone https://github.com/jaeles-project/gospider.git /src/gospider
WORKDIR /src/gospider
RUN go build -o /usr/local/bin/gospider

# Minimal runtime image
FROM alpine:3.18
COPY --from=builder /usr/local/bin/gospider /usr/local/bin/gospider
