FROM golang:1.24-alpine AS builder

RUN apk add --no-cache git
RUN git clone https://github.com/jaeles-project/gospider.git /gospider \
    && cd /gospider \
    && git checkout v1.1.6 \
    && go build -o /usr/local/bin/gospider .

# Minimal runtime image
FROM alpine:3.18
COPY --from=builder /usr/local/bin/gospider /usr/local/bin/gospider